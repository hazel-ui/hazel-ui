{
  "name": "hazel-ui",
  "version": "0.4.5",
  "description": "A flexible React component library.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./fonts.css": {
      "types": "./dist/fonts.css.d.ts",
      "default": "./dist/fonts.css"
    },
    "./*": {
      "types": "./dist/exports/*.d.ts",
      "default": "./dist/exports/*.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "private": false,
  "bugs": "https://github.com/hazel-ui/hazel-ui/issues",
  "homepage": "https://hazel-ui.github.io/hazel-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/hazel-ui/hazel-ui.git"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o ./dist-storybook",
    "serve-storybook": "npx http-server ./dist-storybook",
    "lint": "oxlint -c oxlint.jsonc --deny-warnings",
    "lint:fix": "oxlint -c oxlint.jsonc --fix",
    "formatter": "oxfmt --check src .storybook docs",
    "formatter:fix": "oxfmt src .storybook docs",
    "clean:css": "cd src/package && cleancss -o static/styles.css foundation/Theme/styles/*.css",
    "predev": "pnpm clean:css",
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "start": "npx http-server ./build -o",
    "test": "echo \"Error: no test specified\" && exit 0",
    "build:compile": "rollup --config rollup.config.ts --configPlugin typescript",
    "build:static": "copyfiles -u 2 \"src/static/**/*\" dist",
    "build:package": "rm -rf dist && pnpm build:compile",
    "postbuild:package": "pnpm build:static",
    "change:add": "changeset add",
    "prepublishOnly": "pnpm build:package",
    "predeploy": "pnpm build-storybook",
    "deploy": "gh-pages -d ./dist-storybook"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "0.0.13",
    "@styled-icons/boxicons-regular": "10.23.0",
    "@styled-icons/boxicons-solid": "10.37.0",
    "rc-slider": "9.7.2",
    "react-select": "5.10.2",
    "react-table": "7.5.2",
    "react-toastify": "11.1.0",
    "styled-components": "6.4.1",
    "styled-system": "5.1.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.4.8",
    "@changesets/cli": "2.26.0",
    "@jest/globals": "30.3.0",
    "@rollup/plugin-terser": "0.3.0",
    "@rollup/plugin-typescript": "11.0.0",
    "@storybook/addon-docs": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "11.2.5",
    "@types/jest": "26.0.16",
    "@types/node": "14.14.27",
    "@types/react": "18.0.26",
    "@types/react-dom": "18.0.10",
    "@types/react-select": "3.0.28",
    "@types/react-table": "7.0.24",
    "@types/styled-components": "5.1.36",
    "@types/styled-system": "5.1.10",
    "@vanilla-extract/css": "1.20.1",
    "@vanilla-extract/rollup-plugin": "1.2.0",
    "@vanilla-extract/vite-plugin": "5.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "clean-css-cli": "5.3.0",
    "copyfiles": "2.4.1",
    "gh-pages": "3.1.0",
    "jest": "27.0.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rollup": "3.10.0",
    "storybook": "8.6.18",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "vite": "6.4.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "react",
    "ui",
    "library",
    "design-system",
    "react-components",
    "components",
    "styled-components"
  ],
  "author": "Abhijeet Singh",
  "license": "MIT"
}
