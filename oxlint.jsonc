{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "warn"
  },
  "env": { "browser": true, "node": true },
  "rules": {
    /***********************************************************
     * 1. ESLint rules
     ***********************************************************/

    /**
     * Use curly braces in multiline conditionals.
     * @see https://eslint.org/docs/rules/curly
     */
    "curly": ["error", "multi-line"],

    /**
     * Large files should be split into smaller modules.
     * @see https://eslint.org/docs/rules/max-lines
     */
    "max-lines": "warn",

    /**
     * Disallow type conversion with short notations that are hard to read.
     * @see https://eslint.org/docs/rules/no-implicit-coercion
     */
    "no-implicit-coercion": "warn",

    /**
     * Opinionated style rule not in original ESLint config.
     */
    "func-style": ["warn", "declaration", { "allowArrowFunctions": true }],

    /**
     * Comments don't need to start with a capital letter.
     * @see https://eslint.org/docs/rules/capitalized-comments
     */
    "capitalized-comments": "off",

    /**
     * Keys are sometimes grouped intentionally (e.g. by category) rather than alphabetically.
     */
    "sort-keys": "off",

    /**
     * Ternaries are idiomatic in JSX render.
     */
    "no-ternary": "off",
    "no-nested-ternary": "off",
    "unicorn/no-nested-ternary": "off",

    /**
     * We use null legitimately (e.g. React render returns, exhaustive switch defaults).
     */
    "no-null": "off",

    /**
     * Too many legitimate short identifiers (type params, size enums, callbacks).
     */
    "id-length": "off",

    /**
     * Conflicts with import type convention — type imports and value imports from
     * the same module are intentionally separate per project style.
     */
    "no-duplicate-imports": "off",

    /********************************************************************
     * 2. typescript-eslint rules
     ********************************************************************/

    /**
     * Too many legitimate numeric constants in design tokens and CSS values.
     */
    "no-magic-numbers": "off",

    /*****************************************************************
     * 3. plugin rules
     *****************************************************************/

    /**
     * Prefer named exports.
     * @see https://basarat.gitbooks.io/typescript/docs/tips/defaultIsBad.html
     */
    "import/no-default-export": "error",

    /**
     * Warn when JSX nesting exceeds 5 levels to nudge against deeply nested DOM.
     * @see https://developer.chrome.com/docs/lighthouse/performance/dom-size
     */
    "react/jsx-max-depth": ["warn", { "max": 5 }],

    /**
     * Conflicts with import/no-default-export — we enforce named exports everywhere.
     */
    "import/no-named-export": "off",

    /**
     * Conflicts with import/no-default-export — we enforce named exports everywhere.
     */
    "import/prefer-default-export": "off",

    /**
     * We group type exports separately.
     */
    "import/group-exports": "off",

    /**
     * CSS files and jest-dom setup are legitimate side-effect imports.
     */
    "import/no-unassigned-import": "off",

    /**
     * React default import is not needed in new JSX transform.
     * @see https://github.com/airbnb/javascript/issues/2334
     */
    "react/react-in-jsx-scope": "off",

    /**
     * We spread props intentionally throughout the codebase (e.g. passing rest
     * props to underlying elements for composability).
     */
    "react/jsx-props-no-spreading": "off",

    /**
     * File names can follow different case styles to differentiate
     * types & components (PascalCase) from functions (camelCase).
     * @see https://github.com/sindresorhus/eslint-plugin-unicorn/blob/main/docs/rules/filename-case.md
     */
    "unicorn/filename-case": "off",

    /**
     * Empty import specifiers (`import type {} from "..."`) are valid TypeScript
     * for triggering module augmentation side-effects.
     * @see https://www.typescriptlang.org/docs/handbook/declaration-merging.html
     */
    "import/no-empty-named-blocks": "off",
    "unicorn/require-module-specifiers": "off",

    /**
     * oxfmt owns import ordering via sortImports — disable the oxlint duplicate.
     */
    "sort-imports": "off"

    // Rules handled by oxfmt (formatter, not linter):
    // "@typescript-eslint/quotes"  — oxfmt singleQuote: false (double quotes)
    // "import/order"               — oxfmt sortImports

    // Rules with no oxlint equivalent yet (tracked as custom oxlint plugins — see feedback-plan.md PR 31):
    // "@typescript-eslint/naming-convention" // check: https://github.com/oxc-project/oxc/issues/2180
    // "import/no-extraneous-dependencies" // check: https://github.com/oxc-project/oxc/issues/1117
    // "unicorn/prevent-abbreviations" // check: https://github.com/oxc-project/oxc/issues/684
  },
  "overrides": [
    {
      // Allow require() calls in .js files.
      "files": ["**/*.js"],
      "rules": {
        "typescript/no-var-requires": "off"
      }
    },
    {
      // Scope jest plugin rules to test files only.
      // jest/unbound-method has no oxlint equivalent yet — tracked in feedback-plan.md PR 31.
      "files": ["**/__tests__/*", "**/*.test.ts", "**/*.test.tsx"],
      "plugins": ["jest"],
      "env": { "jest": true },
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      // Storybook and config files conventionally use default exports and inline named exports.
      "files": ["**/*.stories.*", "**/*.config.*", "**/webpack.*.mjs", "**/.storybook/main.js"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      // Build and config files legitimately import Node.js built-ins.
      "files": ["rollup.config.ts", "app/webpack.*.mjs"],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      // Webpack config files use anonymous default exports by convention.
      "files": ["app/webpack.*.mjs", "**/.storybook/main.js"],
      "rules": {
        "import/no-anonymous-default-export": "off"
      }
    },
  ],
  "ignorePatterns": ["node_modules", "dist", "build", "dist-storybook", "coverage"]
}
